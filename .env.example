# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200
APP_PUBLIC_BASE_URL=http://localhost:3000

# Database (local)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=techstore_user
DB_PASSWORD=change_me
DB_NAME=techstore
DB_LOGGING=false
DB_SSL=false
# Automatic schema synchronization is intentionally unsupported.
# All schema changes must be applied through versioned migrations.
DB_SYNCHRONIZE=false

# Database (prod)
DATABASE_URL=mysql://techstore_user:change_me@mysql:3306/techstore

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=59m
JWT_REFRESH_TTL=30d
COOKIE_NAME=rt
COOKIE_SAMESITE=lax

# Mailer
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# Tickets
STANDARD_QUOTE_SWEEP_MINUTES=30
STANDARD_QUOTE_EXPIRATION_HOURS=48

# Service order SLAs
# Targets base en MINUTOS por etapa/tipo.
# La prioridad ajusta estos targets con multiplicadores:
# HIGH = más estricto, MEDIUM = base, LOW = más permisivo.
# `timeToService` mide ejecución pura: serviceStartedAt -> serviceCompletedAt.
SERVICE_ORDER_SLA_PRIORITY_HIGH_MULTIPLIER=0.5
SERVICE_ORDER_SLA_PRIORITY_MEDIUM_MULTIPLIER=1
SERVICE_ORDER_SLA_PRIORITY_LOW_MULTIPLIER=1.5
SERVICE_ORDER_SLA_CUSTOMER_SERVICE_ASSIGNMENT_MINUTES=30
SERVICE_ORDER_SLA_CUSTOMER_SERVICE_DIAGNOSIS_MINUTES=120
SERVICE_ORDER_SLA_CUSTOMER_SERVICE_SERVICE_MINUTES=240
SERVICE_ORDER_SLA_CUSTOMER_SERVICE_PICKUP_MINUTES=720
SERVICE_ORDER_SLA_ASSEMBLY_ASSIGNMENT_MINUTES=60
SERVICE_ORDER_SLA_ASSEMBLY_DIAGNOSIS_MINUTES=60
SERVICE_ORDER_SLA_ASSEMBLY_SERVICE_MINUTES=480
SERVICE_ORDER_SLA_ASSEMBLY_PICKUP_MINUTES=1440
SERVICE_ORDER_SLA_DIAGNOSIS_ASSIGNMENT_MINUTES=60
SERVICE_ORDER_SLA_DIAGNOSIS_DIAGNOSIS_MINUTES=240
SERVICE_ORDER_SLA_DIAGNOSIS_SERVICE_MINUTES=120
SERVICE_ORDER_SLA_DIAGNOSIS_PICKUP_MINUTES=1440
SERVICE_ORDER_SLA_STANDARD_SERVICE_ASSIGNMENT_MINUTES=120
SERVICE_ORDER_SLA_STANDARD_SERVICE_DIAGNOSIS_MINUTES=480
SERVICE_ORDER_SLA_STANDARD_SERVICE_SERVICE_MINUTES=1440
SERVICE_ORDER_SLA_STANDARD_SERVICE_PICKUP_MINUTES=1440
SERVICE_ORDER_SLA_WARRANTY_SERVICE_ASSIGNMENT_MINUTES=120
SERVICE_ORDER_SLA_WARRANTY_SERVICE_DIAGNOSIS_MINUTES=480
SERVICE_ORDER_SLA_WARRANTY_SERVICE_SERVICE_MINUTES=2880
SERVICE_ORDER_SLA_WARRANTY_SERVICE_PICKUP_MINUTES=2880

# Integrations
WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
SERVICE_ORDER_INBOX_BACKFILL_ON_BOOT=true
WHATSAPP_TEMPLATE_ORDER_INTAKE_NAME=ordenes_ingresadas_asignadas
WHATSAPP_TEMPLATE_ORDER_INTAKE_LANGUAGE=es
WHATSAPP_TEMPLATE_STANDARD_ORDER_NAME=orden_standard_confirmada
WHATSAPP_TEMPLATE_STANDARD_ORDER_LANGUAGE=es
WHATSAPP_TEMPLATE_DIAGNOSIS_AGREEMENT_NAME=diagnostico_y_acuerdo_disponible
WHATSAPP_TEMPLATE_DIAGNOSIS_AGREEMENT_LANGUAGE=es
WHATSAPP_TEMPLATE_REDIAGNOSIS_AGREEMENT_NAME=rediagnostico_y_nuevo_acuerdo
WHATSAPP_TEMPLATE_REDIAGNOSIS_AGREEMENT_LANGUAGE=es
WHATSAPP_TEMPLATE_AUTHORIZATION_CONFIRMED_NAME=autorizacion_confirmada_inicio_servicio
WHATSAPP_TEMPLATE_AUTHORIZATION_CONFIRMED_LANGUAGE=es
WHATSAPP_TEMPLATE_READY_FOR_PICKUP_NAME=equipo_listo_retiro
WHATSAPP_TEMPLATE_READY_FOR_PICKUP_LANGUAGE=es
WHATSAPP_TEMPLATE_NO_SOLUTION_NAME=orden_sin_solucion
WHATSAPP_TEMPLATE_NO_SOLUTION_LANGUAGE=es
WHATSAPP_TEMPLATE_CANCEL_WITH_FEE_NAME=orden_cancelada_con_cobro_diagnostico
