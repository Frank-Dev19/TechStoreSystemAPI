SERVICE_ORDER_SURVEY_TOKEN_SECRET=
SERVICE_ORDER_SURVEY_VALID_DAYS=7
SERVICE_ORDER_TEMP_DOCUMENT_TTL_MINUTES=1440
# Provisional pickup policy used by the final-service PDF.
SERVICE_ORDER_PICKUP_FREE_STORAGE_DAYS=7
SERVICE_ORDER_PICKUP_DAILY_STORAGE_FEE=2.00
SERVICE_ORDER_PICKUP_REMINDER_DAY=30
SERVICE_ORDER_PICKUP_ADMIN_REVIEW_DAY=90
SERVICE_ORDER_PICKUP_POLICY_PROVISIONAL=true
PRIVATE_STORAGE_ROOT=./storage
N8N_WEBHOOK_BASE_URL=

# APIsPeru - Electronic billing
APIS_PERU_TOKEN=change_me
APIS_PERU_BASE_URL=https://facturacion.apisperu.com/api/v1
