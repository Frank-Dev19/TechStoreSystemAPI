SERVICE_ORDER_NOTIFICATION_SCHEDULER_CRON=0 */15 * * * *
WHATSAPP_NOTIFICATION_RETRY_ENABLED=true
WHATSAPP_NOTIFICATION_RETRY_DELAYS_MINUTES=1,5,30
